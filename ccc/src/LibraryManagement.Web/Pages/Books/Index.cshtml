@page

@model LibraryManagement.Web.Pages.Books.IndexModel

@{

    ViewData["Title"] = "Kitaplar";

}



<h2>Kitaplar</h2>



<form method="post" asp-page-handler="Add" class="row g-2 mb-4">

    <div class="col-md-3"><input asp-for="Title" class="form-control" placeholder="Başlık" required /></div>

    <div class="col-md-2"><input asp-for="Author" class="form-control" placeholder="Yazar" required /></div>

    <div class="col-md-2"><input asp-for="Isbn" class="form-control" placeholder="ISBN" required /></div>

    <div class="col-md-1"><input asp-for="TotalCopies" class="form-control" type="number" min="1" /></div>

    <div class="col-md-2"><button type="submit" class="btn btn-primary">Ekle</button></div>

</form>



<table class="table table-striped">

    <thead><tr><th>Başlık</th><th>Yazar</th><th>ISBN</th><th>Müsait/Toplam</th><th>İşlem</th></tr></thead>

    <tbody>

    @foreach (var book in Model.Books)

    {

        <tr>

            <td>@book.Title</td>

            <td>@book.Author</td>

            <td>@book.Isbn</td>

            <td>@book.AvailableCopies / @book.TotalCopies</td>

            <td>

                <button type="button" class="btn btn-sm btn-secondary edit-book-btn"

                        data-id="@book.Id"

                        data-title="@book.Title"

                        data-author="@book.Author"

                        data-isbn="@book.Isbn"

                        data-copies="@book.TotalCopies">

                    Düzenle

                </button>

                <form method="post" asp-page-handler="Delete" class="d-inline">

                    <input type="hidden" name="id" value="@book.Id" />

                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</button>

                </form>

            </td>

        </tr>

    }

    </tbody>

</table>



<div class="modal fade" id="editBookModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <form method="post" asp-page-handler="Edit">

                <div class="modal-header">

                    <h5 class="modal-title">Kitap Düzenle</h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <input type="hidden" asp-for="EditId" id="editId" />

                    <div class="mb-3">

                        <label class="form-label">Başlık</label>

                        <input asp-for="Title" class="form-control" id="editTitle" required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Yazar</label>

                        <input asp-for="Author" class="form-control" id="editAuthor" required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">ISBN</label>

                        <input asp-for="Isbn" class="form-control" id="editIsbn" required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Toplam Kopya</label>

                        <input asp-for="TotalCopies" class="form-control" id="editCopies" type="number" min="1" required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>

                    <button type="submit" class="btn btn-primary">Kaydet</button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Scripts {

<script>

    document.querySelectorAll('.edit-book-btn').forEach(btn => {

        btn.addEventListener('click', () => {

            document.getElementById('editId').value = btn.dataset.id;

            document.getElementById('editTitle').value = btn.dataset.title;

            document.getElementById('editAuthor').value = btn.dataset.author;

            document.getElementById('editIsbn').value = btn.dataset.isbn;

            document.getElementById('editCopies').value = btn.dataset.copies;

            new bootstrap.Modal(document.getElementById('editBookModal')).show();

        });

    });

</script>

}


